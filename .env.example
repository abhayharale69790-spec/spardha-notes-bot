# ==============================================================================
# Telegram Study Platform - Production Environment Configuration
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Public Broadcast Channel ID or @username (e.g. -1001234567890 or @mpsc_study_hub)
MAIN_CHANNEL_ID=-1001234567890

# Private Admin Staging Channel ID for Moderation (e.g. -1009876543210)
STAGING_CHANNEL_ID=-1009876543210

# Private Channel for Automated Disaster Recovery Database Backups
BACKUP_CHANNEL_ID=-1001122334455

# Comma-separated list of Telegram User IDs who have admin moderation rights
ADMIN_USER_IDS=123456789,987654321

# Database Connection URL:
# PostgreSQL (Docker/Prod): postgresql+asyncpg://studyuser:studypassword@localhost:5432/studybot_db
# SQLite (Local/Standalone): sqlite+aiosqlite:///data/study_platform.db
DATABASE_URL=postgresql+asyncpg://studyuser:studypassword@localhost:5432/studybot_db

# PostgreSQL Credentials (Used by docker-compose)
POSTGRES_USER=studyuser
POSTGRES_PASSWORD=studypassword
POSTGRES_DB=studybot_db

# Redis Connection URL (Optional)
REDIS_URL=redis://localhost:6379/0

# Timers & Frequencies
SCRAPE_INTERVAL_MINUTES=15
BACKUP_INTERVAL_HOURS=24

# Storage Directories
DOWNLOAD_DIR=downloads
BACKUP_DIR=backups
